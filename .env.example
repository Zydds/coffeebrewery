APP_NAME=Coffeebrewery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production Vercel values: APP_ENV=production, APP_DEBUG=false,
# APP_URL=https://your-production-domain.example, and a generated APP_KEY.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default. Set these to Neon PostgreSQL values in Vercel.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SSLMODE=require

# Database sessions work with Neon. Use SESSION_SECURE_COOKIE=true in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Vercel has no queue worker. Use sync unless a separate worker is deployed.
QUEUE_CONNECTION=sync

# Neon-backed cache is supported for this app. Set CACHE_STORE=database in Vercel.
CACHE_STORE=database

# Cloudinary media storage
CLOUDINARY_URL=

# Seed/admin setup values. Set them only when running the admin seeder.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
